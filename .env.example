# Copy to .env and fill in. Never commit the real .env.

# Privy auth — get these from the Privy dashboard (dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Private key used by the resolve/rounds cron to send transactions (leave empty to disable)
RESOLVER_KEY=

# Robinhood Chain RPC
EVM_RPC_URL=https://robinhood-rpc.publicnode.com

# Deployed Presage contracts on Robinhood Chain (public addresses)
NEXT_PUBLIC_PRESAGE_ADDRESS=0xfcfbb9365ffb00d153ba73162c178916855f8b3b
NEXT_PUBLIC_TWAP_RESOLVER_ADDRESS=0x9249c9eeddd5188eac6e86c804a1255249f1cec3
NEXT_PUBLIC_ADMIN_RESOLVER_ADDRESS=0x6fc7dbbd27039d77f4f22d10e67938e4bddb4d31
NEXT_PUBLIC_STOCKDUEL_ADDRESS=0x646c1bf51d20ce0d794fbaebdb9bc17a110c9d9f
NEXT_PUBLIC_PROFILE_REGISTRY_ADDRESS=0x47c9908766ef11f69caf120134f6e9c6ab23201b

# First block to scan for events (deploy block of the core contract)
PRESAGE_DEPLOY_BLOCK=50890618
